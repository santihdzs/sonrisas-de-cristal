# Copia este archivo como .env (PowerShell: Copy-Item .env.example .env) y llena los valores.
# El .env guarda secretos: esta en .gitignore y NUNCA se sube al repositorio.

# Obligatoria. Contrasena de PostgreSQL: larga, solo letras, numeros y guiones (va dentro de la URL de conexion).
# El valor de ejemplo sirve para levantar la demo tal cual (la base no expone puertos); en produccion cambiala por una aleatoria: openssl rand -hex 24
POSTGRES_PASSWORD=sonrisas-demo-local-cambiar-en-produccion

# true = carga las cuentas de la demo (contrasena demo). En produccion: false
DATOS_DEMO=true

# Solo con DATOS_DEMO=false: contrasena inicial de la cuenta "fundacion" (12 caracteres o mas)
CLAVE_FUNDACION=

# true detras del tunel o de Render: la ip real del cliente llega en X-Forwarded-For
PROXY_CONFIABLE=true

# 127.0.0.1 = solo esta computadora y su emulador. 0.0.0.0 abre el puerto a toda la red por http sin cifrar (solo pruebas)
HOST_IP=127.0.0.1
